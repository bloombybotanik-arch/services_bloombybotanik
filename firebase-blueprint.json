{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with status and subscription tracking",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "status": { 
          "type": "string", 
          "enum": ["gratuit", "freemium", "premium", "owner"] 
        },
        "isPremiumUntil": { "type": "string", "format": "date-time" },
        "machineOwned": { "type": "boolean" },
        "machineSerialNumber": { "type": "string" },
        "optInNewsletter": { "type": "boolean" },
        "optInNurturing": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastActivityAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "status", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Bloom items: Machine, Kits, or Subscriptions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["machine", "kit", "subscription"] },
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "priceCents": { "type": "integer" },
        "currency": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "type", "name", "priceCents"]
    },
    "Order": {
      "title": "Order",
      "description": "Purchase records for machine and kits",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "items": { "type": "array" },
        "totalCents": { "type": "integer" },
        "status": { "type": "string", "enum": ["pending", "paid", "shipped", "canceled"] },
        "shippingAddress": { "type": "object" },
        "stripeSessionId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "items", "totalCents", "status", "createdAt"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "SaaS recurring billing info",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "stripeSubscriptionId": { "type": "string" },
        "planId": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "past_due", "trialing", "canceled"] },
        "currentPeriodEnd": { "type": "string", "format": "date-time" },
        "cancelAtPeriodEnd": { "type": "boolean" }
      },
      "required": ["userId", "stripeSubscriptionId", "status"]
    },
    "Interaction": {
      "title": "Interaction",
      "description": "Tracking for CRM and personalized marketing",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "metadata": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Individual user profiles"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Public product catalog"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Order history"
    },
    "/subscriptions/{subId}": {
      "schema": "Subscription",
      "description": "User subscriptions"
    },
    "/interactions/{interactionId}": {
      "schema": "Interaction",
      "description": "CRM activity logs"
    }
  }
}
