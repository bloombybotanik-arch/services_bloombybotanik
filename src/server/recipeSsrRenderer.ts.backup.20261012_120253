import { CANONICAL_RECIPES, CATEGORY_METADATA, CanonicalRecipe } from '../data/canonicalRecipesRegistry';

export interface SsrPageData {
  title: string;
  description: string;
  canonicalUrl: string;
  ogImage: string;
  jsonLd: Record<string, any>;
  bodyHtml: string;
}

export function getRecipePageSsrData(pathname: string): SsrPageData | null {
  const normalized = pathname.replace(/\/+$/, '') || '/';

  // 1. Hub: /recettes
  if (normalized === '/recettes') {
    const meta = CATEGORY_METADATA['hub'];
    const recipes = CANONICAL_RECIPES;

    const jsonLd = {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": meta.title,
      "description": meta.metaDescription,
      "url": "https://bloombybotanik.com/recettes/",
      "hasPart": recipes.map(r => ({
        "@type": r.schemaType,
        "name": r.title,
        "url": `https://bloombybotanik.com${r.canonicalUrl}`,
        "description": r.summary
      }))
    };

    const bodyHtml = `
      <main class="max-w-6xl mx-auto px-4 py-12">
        <header class="mb-10 text-center">
          <span class="text-xs uppercase tracking-widest text-emerald-800 font-semibold">Bloom by BotaniK</span>
          <h1 class="text-3xl sm:text-4xl font-serif text-stone-900 mt-2 mb-4">${meta.title}</h1>
          <p class="max-w-2xl mx-auto text-stone-600">${meta.intro}</p>
        </header>
        <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          ${recipes.map(r => `
            <article class="bg-white border border-stone-200 rounded-xl p-5 shadow-sm">
              <h2 class="text-lg font-serif font-semibold text-stone-900 mb-2">
                <a href="${r.canonicalUrl}" class="hover:text-emerald-800">${r.title}</a>
              </h2>
              <p class="text-xs text-stone-500 mb-2">${r.categoryLabel} • ${r.difficulty} • ${r.totalTimeMinutes} min</p>
              <p class="text-sm text-stone-600 line-clamp-3 mb-4">${r.summary}</p>
              <a href="${r.canonicalUrl}" class="text-xs uppercase tracking-wider font-semibold text-emerald-800 hover:underline">Découvrir la recette &rarr;</a>
            </article>
          `).join('')}
        </section>
      </main>
    `;

    return {
      title: meta.title,
      description: meta.metaDescription,
      canonicalUrl: 'https://bloombybotanik.com/recettes/',
      ogImage: 'https://bloombybotanik.com/images/og/bloom-extracteur-infuseur-botanique-1200x630.jpg',
      jsonLd,
      bodyHtml
    };
  }

  // 2. Categories: /recettes/culinaires, /recettes/cosmetiques, /recettes/parcours-botaniques
  const catMatches: Record<string, string> = {
    '/recettes/culinaires': 'culinaires',
    '/recettes/cosmetiques': 'cosmetiques',
    '/recettes/parcours-botaniques': 'parcours-botaniques'
  };

  if (catMatches[normalized]) {
    const catKey = catMatches[normalized];
    const meta = CATEGORY_METADATA[catKey];
    const categoryFilter = catKey === 'parcours-botaniques' ? 'parcours-guide' : catKey === 'culinaires' ? 'culinaire' : 'cosmetique';
    const recipes = CANONICAL_RECIPES.filter(r => r.category === categoryFilter);

    const jsonLd = {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": meta.title,
      "description": meta.metaDescription,
      "url": `https://bloombybotanik.com${meta.path}`,
      "hasPart": recipes.map(r => ({
        "@type": r.schemaType,
        "name": r.title,
        "url": `https://bloombybotanik.com${r.canonicalUrl}`,
        "description": r.summary
      }))
    };

    const bodyHtml = `
      <main class="max-w-6xl mx-auto px-4 py-12">
        <header class="mb-10 text-center">
          <nav class="text-xs text-stone-500 mb-2">
            <a href="/recettes/" class="hover:underline">Recettes</a> &gt; <span>${meta.title}</span>
          </nav>
          <h1 class="text-3xl sm:text-4xl font-serif text-stone-900 mt-2 mb-4">${meta.title}</h1>
          <p class="max-w-2xl mx-auto text-stone-600">${meta.intro}</p>
        </header>
        <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          ${recipes.map(r => `
            <article class="bg-white border border-stone-200 rounded-xl p-5 shadow-sm">
              <h2 class="text-lg font-serif font-semibold text-stone-900 mb-2">
                <a href="${r.canonicalUrl}" class="hover:text-emerald-800">${r.title}</a>
              </h2>
              <p class="text-xs text-stone-500 mb-2">${r.difficulty} • ${r.totalTimeMinutes} min</p>
              <p class="text-sm text-stone-600 mb-4">${r.summary}</p>
              <a href="${r.canonicalUrl}" class="text-xs uppercase tracking-wider font-semibold text-emerald-800 hover:underline">Lire la suite &rarr;</a>
            </article>
          `).join('')}
        </section>
      </main>
    `;

    return {
      title: meta.title,
      description: meta.metaDescription,
      canonicalUrl: `https://bloombybotanik.com${meta.path}`,
      ogImage: 'https://bloombybotanik.com/images/og/bloom-extracteur-infuseur-botanique-1200x630.jpg',
      jsonLd,
      bodyHtml
    };
  }

  // 3. Single Recipe: /recettes/:category/:slug
  const recipe = CANONICAL_RECIPES.find(r => {
    const recipeNorm = r.canonicalUrl.replace(/\/+$/, '');
    return recipeNorm === normalized;
  });

  if (recipe) {
    const isRecipeSchema = recipe.schemaType === 'Recipe';
    const jsonLd: Record<string, any> = isRecipeSchema
      ? {
          "@context": "https://schema.org",
          "@type": "Recipe",
          "name": recipe.title,
          "description": recipe.summary,
          "image": recipe.image.startsWith('http') ? recipe.image : `https://bloombybotanik.com${recipe.image}`,
          "prepTime": `PT${recipe.activeTimeMinutes}M`,
          "cookTime": `PT${recipe.machineTimeMinutes}M`,
          "totalTime": `PT${recipe.totalTimeMinutes}M`,
          "recipeCategory": recipe.categoryLabel,
          "recipeIngredient": recipe.ingredients,
          "recipeInstructions": recipe.instructions.map((step, idx) => ({
            "@type": "HowToStep",
            "position": idx + 1,
            "text": step
          }))
        }
      : {
          "@context": "https://schema.org",
          "@type": "Article",
          "headline": recipe.title,
          "description": recipe.summary,
          "image": recipe.image.startsWith('http') ? recipe.image : `https://bloombybotanik.com${recipe.image}`
        };

    const bodyHtml = `
      <article class="max-w-4xl mx-auto px-4 py-12">
        <nav class="text-xs text-stone-500 mb-4">
          <a href="/recettes/" class="hover:underline">Recettes</a> &gt;
          <a href="/recettes/${recipe.category === 'parcours-guide' ? 'parcours-botaniques' : recipe.category === 'culinaire' ? 'culinaires' : 'cosmetiques'}/" class="hover:underline">${recipe.categoryLabel}</a> &gt;
          <span>${recipe.title}</span>
        </nav>
        <header class="mb-8">
          <h1 class="text-3xl sm:text-4xl font-serif text-stone-900 mb-4">${recipe.title}</h1>
          <p class="text-lg text-stone-600 mb-4">${recipe.summary}</p>
          <div class="flex flex-wrap gap-4 text-xs font-semibold text-stone-500 uppercase tracking-wider">
            <span>Difficulté: ${recipe.difficulty}</span>
            <span>Préparation: ${recipe.activeTimeMinutes} min</span>
            <span>BloomLab: ${recipe.machineTimeMinutes} min</span>
            ${recipe.temperatures ? `<span>Température: ${recipe.temperatures}</span>` : ''}
          </div>
        </header>

        <section class="grid grid-cols-1 md:grid-cols-2 gap-8 my-8">
          <div class="bg-stone-50 border border-stone-200 rounded-xl p-6">
            <h2 class="text-lg font-serif font-semibold text-stone-900 mb-4">Ingrédients requis</h2>
            <ul class="list-disc list-inside space-y-2 text-stone-700 text-sm">
              ${recipe.ingredients.map(ing => `<li>${ing}</li>`).join('')}
            </ul>
          </div>
          <div class="bg-stone-50 border border-stone-200 rounded-xl p-6">
            <h2 class="text-lg font-serif font-semibold text-stone-900 mb-4">Matériel & Équipement</h2>
            <ul class="list-disc list-inside space-y-2 text-stone-700 text-sm">
              ${recipe.equipment.map(eq => `<li>${eq}</li>`).join('')}
            </ul>
          </div>
        </section>

        <section class="my-8">
          <h2 class="text-xl font-serif font-semibold text-stone-900 mb-4">Instructions pas à pas</h2>
          <ol class="space-y-4">
            ${recipe.instructions.map((step, idx) => `
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 rounded-full bg-emerald-800 text-white flex items-center justify-center font-bold text-sm">${idx + 1}</span>
                <p class="text-stone-700 pt-1 leading-relaxed">${step}</p>
              </li>
            `).join('')}
          </ol>
        </section>
      </article>
    `;

    return {
      title: `${recipe.title} | Bloom by BotaniK`,
      description: recipe.summary,
      canonicalUrl: `https://bloombybotanik.com${recipe.canonicalUrl}`,
      ogImage: recipe.image.startsWith('http') ? recipe.image : `https://bloombybotanik.com${recipe.image}`,
      jsonLd,
      bodyHtml
    };
  }

  return null;
}

export function renderRecipeHtml(templateHtml: string, ssrData: SsrPageData): string {
  let result = templateHtml;

  // Replace title
  result = result.replace(/<title>.*?<\/title>/i, `<title>${ssrData.title}</title>`);

  // Replace meta description
  result = result.replace(
    /<meta\s+name="description"\s+content=".*?"\s*\/?>/i,
    `<meta name="description" content="${ssrData.description}" />`
  );

  // Replace or add OpenGraph tags
  result = result.replace(
    /<meta\s+property="og:title"\s+content=".*?"\s*\/?>/i,
    `<meta property="og:title" content="${ssrData.title}" />`
  );
  result = result.replace(
    /<meta\s+property="og:description"\s+content=".*?"\s*\/?>/i,
    `<meta property="og:description" content="${ssrData.description}" />`
  );

  // Add canonical tag and Schema.org JSON-LD before </head>
  const headAdditions = `
    <link rel="canonical" href="${ssrData.canonicalUrl}" />
    <meta property="og:url" content="${ssrData.canonicalUrl}" />
    <meta property="og:image" content="${ssrData.ogImage}" />
    <script type="application/ld+json">
      ${JSON.stringify(ssrData.jsonLd)}
    </script>
  `;
  result = result.replace('</head>', `${headAdditions}\n</head>`);

  // Inject body HTML into <div id="root"></div>
  result = result.replace('<div id="root"></div>', `<div id="root">${ssrData.bodyHtml}</div>`);

  return result;
}
